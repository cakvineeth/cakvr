# Manager Pro backend that serves approved blog posts (defaults to production).
MANAGER_PRO_API_URL=https://managerpro-production.up.railway.app

# Shared secret Manager Pro sends to /api/revalidate-blogs so newly approved
# posts appear immediately. Set the same value as WEBSITE_REVALIDATE_SECRET
# in Manager Pro. Without it, posts still appear within 5 minutes.
BLOG_REVALIDATE_SECRET=
